{
  "name": "reday",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "encrypt": "node scripts/encrypt.mjs",
    "audit:colors": "node scripts/audit-colors.mjs",
    "audit:spacing": "node scripts/audit-spacing.mjs",
    "audit:icons": "node scripts/audit-icons.mjs",
    "audit:typography": "node scripts/audit-typography.mjs",
    "audit:contrast": "node scripts/audit-color-contrast.mjs",
    "audit:contrast:coverage": "node scripts/audit-contrast-coverage.mjs",
    "audit:contrast:strict": "node scripts/audit-color-contrast.mjs --strict && node scripts/audit-contrast-coverage.mjs",
    "audit:target-size": "node scripts/audit-target-size.mjs",
    "audit:sensitive": "node scripts/audit-sensitive.mjs",
    "audit:sensitive:portable": "node scripts/audit-sensitive.mjs --allow-missing",
    "audit:vault": "node scripts/audit-vault.mjs",
    "audit:vault:portable": "node scripts/audit-vault.mjs --allow-missing-local --allow-missing-origin",
    "clean:metadata": "node scripts/clean-macos-metadata.mjs",
    "test:encrypt": "node scripts/test-encrypt.mjs",
    "tokens:colors": "node scripts/export-color-tokens.mjs",
    "tokens:spacing": "node scripts/export-spacing-tokens.mjs",
    "verify:design-system": "npm run build",
    "verify:release": "npm run test:encrypt && npm run audit:sensitive && npm run audit:vault && npm run verify:design-system && npm run audit:sensitive",
    "build": "npm run format:check && npm run lint && npm run test && npm run audit:colors && npm run audit:spacing && npm run audit:icons && npm run audit:typography && npm run audit:contrast:strict && npm run audit:target-size && npm run audit:vault:portable && tsc && vite build && npm run audit:sensitive:portable",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.11"
  }
}
